# ConsumerAssist Configuration

# Database: Default local SQLite for instant zero-config testing:
DATABASE_URL=sqlite:///./consumer_assist.db

# To connect to your Supabase PostgreSQL database directly, use:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & Google OAuth Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server settings
UPLOAD_DIR=./uploads
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# LLM Providers (OpenAI & Google Gemini)
# Add your key to activate real-time LLM routing & multimodal vision OCR:
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key


