# ConsumerAssist Configuration
# Database: defaults to SQLite for zero-config local execution
DATABASE_URL=sqlite:///./consumer_assist.db
# For PostgreSQL/Supabase, uncomment and set:
# DATABASE_URL=postgresql://user:password@localhost:5432/consumer_assist

# Upload directory
UPLOAD_DIR=./uploads

# Server
HOST=0.0.0.0
PORT=8000

# Frontend
FRONTEND_URL=http://localhost:5173

# Optional: HuggingFace cache
# HF_HOME=./hf_cache
